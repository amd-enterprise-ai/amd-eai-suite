{
  "name": "@amdenterpriseai/components",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build:components": "tsc",
    "build:styles": "postcss ./src/styles.css -o ./dist/index.css",
    "check-types": "pnpm run typecheck",
    "dev:components": "tsc --watch",
    "dev:styles": "postcss ./src/styles.css -o ./dist/index.css --watch",
    "format:fix": "biome format --write .",
    "ladle": "ladle serve",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amdenterpriseai/assets": "workspace:*",
    "@amdenterpriseai/hooks": "workspace:*",
    "@amdenterpriseai/layouts": "workspace:*",
    "@amdenterpriseai/types": "workspace:*",
    "@amdenterpriseai/utils": "workspace:*"
  },
  "peerDependencies": {
    "@heroui/react": "*",
    "@tabler/icons-react": "*",
    "i18next": "*",
    "next-i18next": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@amdenterpriseai/tailwind-config": "workspace:*",
    "@ladle/react": "*",
    "@svgr/webpack": "*",
    "@tailwindcss/postcss": "*",
    "@tailwindcss/typography": "*",
    "@tanstack/react-query": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/react": "*",
    "@vitejs/plugin-react": "*",
    "@vitest/coverage-v8": "*",
    "jsdom": "*",
    "next-auth": "*",
    "postcss": "*",
    "postcss-cli": "*",
    "tailwindcss": "*",
    "typescript": "5.9.2",
    "vite": "*",
    "vitest": "*"
  },
  "exports": {
    "./styles.css": "./dist/index.css",
    ".": "./src/index.ts"
  }
}
